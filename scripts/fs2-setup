#!/usr/bin/env python3
"""fs2-setup - create /opt/fs2/config.toml from the template (asks a few questions)."""
import argparse, os, re, secrets, shutil, socket, subprocess, sys, time

PREFIX = os.environ.get("FS2_PREFIX", "/opt/fs2")

SDR_LINES = {
    "sx": "sample_rate = 600000\nrx_gain_lna = 42.0\nrx_gain_pga = 16.0\ntx_gain_dac = 6.0\ntx_gain_mixer = 60.0",
    "pluto": 'device = "driver=plutosdr"\n# Gains: list the names with  SoapySDRUtil --probe  and add lines like  rx_gain_pga = 40.0',
    "lime": 'device = "driver=lime"\n# Gains: list the names with  SoapySDRUtil --probe  and add lines like  rx_gain_lna = 30.0',
}

def fetch_template():
    """Download the config template from the update server and check its Ed25519 signature.
    Returns (text, level). There is no copy of the template on GitHub; it only comes from the update server."""
    import hashlib, json, tempfile, urllib.request
    try:
        base = open(os.path.join(PREFIX, "fs2-update.url")).read().split("\n")[0].strip().rstrip("/")
        pub = open(os.path.join(PREFIX, "fs2-update.pubkey")).read().strip()
    except OSError:
        sys.exit("Update server address/key not found in %s (fs2-update.url / fs2-update.pubkey). Run install.sh again." % PREFIX)
    if not base.startswith("https://") and os.environ.get("FS2_ALLOW_LOCAL") != "1":
        sys.exit("Update server address must start with https://")
    def get(name):
        try:
            with urllib.request.urlopen(urllib.request.Request(base + "/" + name, headers={"User-Agent": "fs2-setup"}), timeout=30) as r:
                return r.read(2_000_000)
        except Exception as e:
            sys.exit("Cannot download %s from the update server (%s): %s\nCheck the internet connection and try again." % (name, base, e))
    man = json.loads(get("config-template.json"))
    body = get("config.template.toml")
    sha = hashlib.sha256(body).hexdigest()
    if sha != str(man.get("sha256", "")).lower():
        sys.exit("The downloaded template does not match its checksum. Nothing was written.")
    level = int(man["level"])
    msg = ("FS2-TEMPLATE-1\n%d\n%s\n" % (level, sha)).encode()
    try:
        sig = bytes.fromhex(man["sig"]); raw = bytes.fromhex(pub)
    except ValueError:
        sys.exit("Bad signature or key format.")
    with tempfile.TemporaryDirectory() as d:
        der = bytes.fromhex("302a300506032b6570032100") + raw
        for n, data in (("pub.der", der), ("msg", msg), ("sig", sig)):
            open(os.path.join(d, n), "wb").write(data)
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", os.path.join(d, "pub.der"), "-keyform", "DER",
                            "-rawin", "-in", os.path.join(d, "msg"), "-sigfile", os.path.join(d, "sig")],
                           capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("The signature of the downloaded template is INVALID. Nothing was written.")
    return body.decode("utf-8"), level

def ask(label, default=None, tty=True):
    if not tty:
        if default is None:
            sys.exit("Missing value for: " + label)
        return str(default)
    suffix = " [%s]" % default if default not in (None, "") else ""
    while True:
        v = input("%s%s: " % (label, suffix)).strip()
        if v:
            return v
        if default not in (None, ""):
            return str(default)

def system_timezone():
    try:
        return open("/etc/timezone").read().strip() or "UTC"
    except OSError:
        return "UTC"

def compute_plan(tx_hz, rx_hz):
    """Return (band, main_carrier, freq_offset_hz, duplex_lines) for a TX/RX pair."""
    band = int(tx_hz // 100_000_000)
    off = tx_hz - band * 100_000_000
    base, r = divmod(off, 25_000)
    if r in (0, 6_250, 12_500):
        carrier, fo = base, r
    elif r == 18_750:
        carrier, fo = base + 1, -6_250
    else:
        sys.exit("TX frequency must be on the 6.25 kHz raster relative to a 25 kHz carrier (offsets 0, +6.25, -6.25, +12.5 kHz).")
    if not (0 <= carrier <= 4095):
        sys.exit("TX frequency out of range for a TETRA carrier number.")
    diff = tx_hz - rx_hz
    if diff == 5_000_000:
        duplex = "duplex_spacing = 4"
    else:
        duplex = ("duplex_spacing = 7\ncustom_duplex_spacing = %d   "
                  "# only valid if your radios have the same custom duplex entry" % diff)
    return band, int(carrier), fo, duplex

def parse_latlon(v):
    try:
        la, lo = [float(x) for x in re.split(r"[,; ]+", v.strip()) if x]
    except ValueError:
        sys.exit("Location must be two decimal numbers: latitude, longitude")
    if not (-90 <= la <= 90 and -180 <= lo <= 180):
        sys.exit("Location out of range.")
    return "%.4f" % la, "%.4f" % lo

def fill_template(text, v):
    """Personalise the template: only the lines that differ per station are replaced, section by section."""
    lines = text.replace("\r", "").split("\n")
    out, sec, skip_gain = [], "", False
    def setkey(l, key, value):
        m = re.match(r"^(\s*)%s\s*=" % re.escape(key), l)
        return (m.group(1) + "%s = %s" % (key, value)) if m else None
    for l in lines:
        h = re.match(r"^\s*(\[\[?[^\]]+\]\]?)\s*(#.*)?$", l)
        if h:
            sec = h.group(1).strip("[]")
        new = None
        if sec == "phy_io.soapysdr":
            new = setkey(l, "tx_freq", v["tx"]) or setkey(l, "rx_freq", v["rx"])
            if new is None and re.match(r"^\s*(sample_rate|rx_gain_lna|rx_gain_pga|tx_gain_dac|tx_gain_mixer)\s*=", l) and v["sdr"] != "sx":
                new = "# " + l.strip() + "   # (LimeSDR/PlutoSDR: use SoapySDRUtil --probe to choose gains)"
            if new is None and v["sdr"] != "sx" and re.match(r"^# device = \"driver=%s" % ("plutosdr" if v["sdr"] == "pluto" else "lime"), l):
                new = l[2:].split(",")[0].rstrip() + '"' if "," in l else l[2:]
        elif sec == "net_info":
            new = setkey(l, "mcc", str(v["mcc"]) + "  # tetra default") or setkey(l, "mnc", v["mnc"])
        elif sec == "cell_info":
            for k, val in (("freq_band", v["band"]), ("main_carrier", v["carrier"]), ("freq_offset", v["fo"]),
                           ("location_area", v["la"]), ("colour_code", v["cc"]), ("timezone", '"%s"' % v["tz"])):
                new = new or setkey(l, k, val)
            if re.match(r"^duplex_spacing\s*=", l):
                new = v["duplex"]
            elif re.match(r"^custom_duplex_spacing\s*=", l):
                new = ""
        elif sec in ("cell_info.home_mode_display", "cell_info.sds_broadcast"):
            new = setkey(l, "text", '"%s"' % v["cell_text"])
        elif sec == "wx_service":
            new = setkey(l, "periodic_icao", '"%s"' % v["icao"])
        elif sec == "dashboard":
            new = setkey(l, "bind", '"%s"' % v["bind"]) or setkey(l, "username", '"%s"' % v["user"]) or setkey(l, "password", '"%s"' % v["password"])
        elif sec == "proximity_notice":
            new = setkey(l, "flowstation_lat", v["lat"]) or setkey(l, "flowstation_lon", v["lon"])
        out.append(l if new is None else new)
    text = "\n".join(out)
    # a station without a neighbour cell must not advertise one: comment the active neighbour block
    lines = text.split("\n")
    start = next((i for i, l in enumerate(lines) if l.strip() == "[[cell_info.neighbor_cells_ca]]"), None)
    if start is not None:
        end = next((i for i in range(start, len(lines)) if lines[i].startswith("# Example with two neighbors")), len(lines))
        for i in range(start, end):
            if lines[i].strip() and not lines[i].lstrip().startswith("#"):
                lines[i] = "# " + lines[i].strip()
        lines[start] = "# (Neighbour cell block disabled: remove the # signs and edit it when you run a second cell.)\n" + lines[start]
    return "\n".join(lines)

def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--sdr", choices=sorted(SDR_LINES), help="radio board type")
    ap.add_argument("--tx-mhz"); ap.add_argument("--rx-mhz")
    ap.add_argument("--mcc"); ap.add_argument("--mnc")
    ap.add_argument("--la"); ap.add_argument("--cc")
    ap.add_argument("--timezone"); ap.add_argument("--dash-user"); ap.add_argument("--dash-pass")
    ap.add_argument("--dash-bind", default="0.0.0.0")
    ap.add_argument("--cell-text"); ap.add_argument("--city", help="name spoken in the announcements"); ap.add_argument("--no-announce", action="store_true"); ap.add_argument("--location", help="latitude, longitude"); ap.add_argument("--icao")
    ap.add_argument("--out", default="/opt/fs2/config.toml")
    ap.add_argument("--yes-legal", action="store_true", help="confirm you may legally transmit on these frequencies")
    ap.add_argument("--non-interactive", action="store_true")
    a = ap.parse_args()
    tty = sys.stdin.isatty() and not a.non_interactive

    print("\nFS2 setup. Press Enter to accept the value in [brackets].\n")
    sdr = a.sdr or ask("Radio board (sx / pluto / lime)", "sx", tty)
    if sdr not in SDR_LINES:
        sys.exit("Unknown board: " + sdr)
    tx = float(a.tx_mhz or ask("Transmit (downlink) frequency in MHz, e.g. 438.025", None, tty))
    rx = float(a.rx_mhz or ask("Receive (uplink) frequency in MHz", "%.6f" % (tx - 5.0), tty))
    tx_hz, rx_hz = int(round(tx * 1e6)), int(round(rx * 1e6))
    band, carrier, freq_offset, duplex_lines = compute_plan(tx_hz, rx_hz)
    if tx_hz - rx_hz != 5_000_000:
        print("\nNOTE: TX - RX = %.4f MHz, not 5 MHz. A custom duplex spacing is written; your radios must be programmed with the same values." % ((tx_hz - rx_hz) / 1e6))
    mcc = a.mcc or ask("Mobile country code (MCC)", "901", tty)
    mnc = a.mnc or ask("Mobile network code (MNC)", "9999", tty)
    la = a.la or ask("Location area", "1", tty)
    cc = a.cc or ask("Colour code (0-63)", "1", tty)
    tz = a.timezone or ask("Timezone", system_timezone(), tty)
    cell_text = a.cell_text or ask("Text shown on the radios' home screen (e.g. your city + cell name)", "FS2 CELL", tty)
    loc = a.location or ask("Station location 'latitude, longitude' (used for weather and Proximity Notice; Enter = skip)", "0, 0", tty)
    lat, lon = parse_latlon(loc)
    city = a.city or ask("City or place name spoken in the announcements (\"TETRA Romania, nod <city>\")", None, tty)
    icao = (a.icao or ask("Nearest airport ICAO code for the weather service (e.g. LROP)", "LROP", tty)).upper()
    user = a.dash_user or ask("Dashboard user name", "admin", tty)
    password = a.dash_pass or secrets.token_urlsafe(12)
    for name, v in (("MCC", mcc), ("MNC", mnc), ("location area", la), ("colour code", cc)):
        if not re.fullmatch(r"\d{1,5}", v):
            sys.exit("%s must be a number." % name)
    if not re.fullmatch(r"[^\n\r\"\\<>{}|;`$]{2,40}", city):
        sys.exit("City name: 2-40 characters, no quotes or special symbols.")
    if not re.fullmatch(r"[A-Za-z0-9]{4}", icao):
        sys.exit("ICAO code must be 4 letters/digits.")
    if not re.fullmatch(r"[A-Za-z0-9 .,_/+()-]{1,40}", cell_text):
        sys.exit("Home screen text: up to 40 letters, digits and . , _ / + ( ) -")
    if not re.fullmatch(r"[A-Za-z0-9_./+-]+", tz):
        sys.exit("Invalid timezone.")
    for name, v in (("user name", user), ("password", password)):
        if not re.fullmatch(r"[A-Za-z0-9_.@-]+", v):
            sys.exit("Dashboard %s may only use letters, digits and _ . @ -" % name)

    if not a.yes_legal:
        print("\nTransmitting on radio frequencies needs a licence or permission in most countries.")
        if not tty:
            sys.exit("Pass --yes-legal to confirm.")
        if input('Type "yes" to confirm you may legally use these frequencies and power: ').strip().lower() != "yes":
            sys.exit("Stopped. Nothing was written.")

    tpl, tpl_level = fetch_template()
    text = fill_template(tpl, dict(
        tx=tx_hz, rx=rx_hz, sdr=sdr, mcc=mcc, mnc=mnc, band=band, carrier=carrier, la=la, cc=cc, tz=tz,
        fo=freq_offset, duplex=duplex_lines, cell_text=cell_text, lat=lat, lon=lon, icao=icao,
        bind=a.dash_bind, user=user, password=password))

    out = a.out
    os.makedirs(os.path.dirname(out), exist_ok=True)
    if os.path.exists(out):
        bak = "%s.bak-%s" % (out, time.strftime("%Y%m%d-%H%M%S"))
        shutil.copy2(out, bak)
        print("Existing config saved as", bak)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    # Remember which config changes are already included, so Update only applies newer ones.
    open(os.path.join(os.path.dirname(out) or ".", "fs2-config.level"), "w").write("%d\n" % tpl_level)
    fb = out + ".fallback"
    if not os.path.exists(fb):
        shutil.copy2(out, fb)
        os.chmod(fb, 0o600)
    try:
        ip = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()[0]
    except Exception:
        ip = socket.gethostname()
    print("\nConfig written to %s" % out)
    print("Dashboard:  http://%s:8080   user: %s   password: %s" % (ip, user, password))
    print("Write the password down now; it is stored only in the config file.")
    print("Start / restart:  sudo systemctl restart fs2")
    if not a.no_announce:
        tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fs2-announce")
        if not os.path.exists(tool):
            tool = "/usr/local/bin/fs2-announce"
        print("\nMaking the spoken announcements for %s (needs internet, takes a few minutes)..." % city)
        rc = subprocess.run([sys.executable, tool, "setup", "--city", city, "--lat", lat, "--lon", lon]).returncode
        if rc != 0:
            print("\nThe announcements could not be made now (the station itself is fine). Try again later with:\n  sudo fs2-announce setup --city \"%s\" --lat %s --lon %s" % (city, lat, lon))

if __name__ == "__main__":
    main()
