# Settings shared by the install scripts.
# GitHub repository that holds the ready-made program files (Releases page).
FS2_REPO="yo9ion/fs2-kit"
# SoapySX driver for the SX1255 board (public project by tejeez), pinned to the tested version.
SXXCVR_REPO="https://github.com/tejeez/sxxcvr.git"
SXXCVR_COMMIT="116d680"
# Update server used by the Update button in the FS2 dashboard (signed updates; nothing installs
# until a person presses the button). Leave empty to disable the button's server.
FS2_UPDATE_URL="https://136-70-24-243.nip.io/fs2"
# Public key that checks the signature of updates and of the first-install config (safe to publish).
FS2_UPDATE_PUBKEY="c1abca4c34625a71a128c11d7f6ae8758220d500ac9e71dbb33994b98688eb1f"
